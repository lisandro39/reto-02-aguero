# Proveedor del modelo: anthropic | gemini | mock (mock no requiere clave, sirve para pruebas)
LLM_PROVIDER=anthropic
# Vacío = modelo por defecto del proveedor (anthropic: claude-haiku-5-5 · gemini: gemini-flash-latest)
LLM_MODEL=
# Respaldo si el principal está saturado, separados por coma (vacío = por defecto del proveedor)
LLM_MODEL_RESPALDO=
# Claves: solo en el .env del servidor, nunca en el repo, el front ni los logs
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Solo Gemini. Razonamiento: low (Gemini 3) o 0 (Gemini 2.5)
LLM_THINKING=
# Código para usar el link público (vacío = sin protección)
ACCESS_CODE=
PORT=3020
# 127.0.0.1: solo accesible vía nginx; el puerto no queda expuesto a internet
HOST=127.0.0.1
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
LLM_TIMEOUT_MS=90000
# true: imprime la latencia de cada llamada al modelo
LOG_LLM=true
RATE_LIMIT_POR_MINUTO=20
MAX_SESIONES=200
# true: cada sesión del chat trabaja sobre su propia copia de los datos
SANDBOX_POR_SESION=true
